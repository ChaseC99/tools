---
import ToolsList from "./ToolsList.astro";
import FeedbackActions from "./FeedbackActions.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";

const { title } = Astro.props;
---

<header class="site-header">
    <nav class="site-navbar" aria-label="Site navigation">
        <div class="site-navbar__title-wrap">
            <h1 class="site-navbar__title">{title}</h1>
            <a href="/" class="site-navbar__home" tabindex="-1">Tools</a>
        </div>

        <div class="site-navbar__actions">
            <ThemeToggle />
            <button
                id="tools-dropdown"
                class="ui-button ui-icon-button tools-toggle"
                data-variant="secondary"
                type="button"
                aria-label="Open tools menu"
                aria-controls="tools-drawer"
                aria-expanded="false"
            >
                <img src="/icons/tool.svg" alt="" aria-hidden="true" />
            </button>
        </div>
    </nav>
</header>

<div id="tools-drawer" class="tools-drawer" aria-hidden="true">
    <div class="tools-drawer__content" role="region" aria-label="Available tools">
        <ToolsList />
        <FeedbackActions />
    </div>
</div>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: var(--ui-z-header);
        border-bottom: 1px solid var(--ui-color-border);
        background: color-mix(in srgb, var(--ui-color-surface) 94%, transparent);
        backdrop-filter: blur(12px);
    }

    .site-navbar {
        min-height: 4.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ui-space-4);
        padding: var(--ui-space-3) var(--ui-space-5);
    }

    .site-navbar__title-wrap {
        position: relative;
        min-width: 0;
        overflow: hidden;
    }

    .site-navbar__title,
    .site-navbar__home {
        overflow: hidden;
        margin: 0;
        color: var(--ui-color-text);
        font-size: clamp(1.25rem, 4vw, 1.65rem);
        font-weight: 750;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: opacity var(--ui-motion-base) var(--ui-ease-standard), transform var(--ui-motion-base) var(--ui-ease-standard);
    }

    .site-navbar__title.is-hidden {
        opacity: 0;
        transform: translateX(-1rem);
    }

    .site-navbar__home {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        text-decoration: none;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-0.75rem);
    }

    .site-navbar__home.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .site-navbar__actions {
        display: flex;
        align-items: center;
        gap: var(--ui-space-2);
        flex: none;
    }

    .tools-toggle img {
        width: 1.35rem;
        height: 1.35rem;
        transition: transform var(--ui-motion-base) var(--ui-ease-standard);
    }

    :global([data-theme="dark"]) .tools-toggle img {
        filter: invert(1);
    }

    .tools-toggle[aria-expanded="true"] img {
        transform: rotate(-90deg);
    }

    .tools-drawer {
        position: fixed;
        inset: 0;
        z-index: var(--ui-z-drawer);
        overflow-y: auto;
        padding: 6rem var(--ui-space-5) var(--ui-space-8);
        background: var(--ui-color-page);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-0.75rem);
        transition: opacity var(--ui-motion-base) var(--ui-ease-standard), transform var(--ui-motion-base) var(--ui-ease-standard), visibility 0s var(--ui-motion-base);
    }

    .tools-drawer.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition: opacity var(--ui-motion-base) var(--ui-ease-standard), transform var(--ui-motion-base) var(--ui-ease-standard), visibility 0s;
    }

    .tools-drawer__content {
        width: min(100%, var(--ui-content-wide));
        margin-inline: auto;
    }

    @media (max-width: 520px) {
        .site-navbar {
            padding-inline: var(--ui-space-4);
        }

        .tools-drawer {
            padding-inline: var(--ui-space-4);
        }
    }
</style>

<script>
    const toolsToggle = document.getElementById("tools-dropdown") as HTMLButtonElement | null;
    const toolsDrawer = document.getElementById("tools-drawer") as HTMLElement | null;
    const pageContent = document.getElementById("page-content") as HTMLElement | null;
    const pageTitle = document.querySelector(".site-navbar__title") as HTMLElement | null;
    const homeLink = document.querySelector(".site-navbar__home") as HTMLAnchorElement | null;
    const isHome = window.location.pathname === "/";

    const setDrawerOpen = (open: boolean) => {
        if (!toolsToggle || !toolsDrawer) return;

        toolsToggle.ariaExpanded = String(open);
        toolsToggle.setAttribute("aria-label", open ? "Close tools menu" : "Open tools menu");
        toolsDrawer.classList.toggle("is-open", open);
        toolsDrawer.setAttribute("aria-hidden", String(!open));
        document.body.classList.toggle("ui-scroll-locked", open);

        if (pageContent) pageContent.inert = open;

        if (!isHome) {
            pageTitle?.classList.toggle("is-hidden", open);
            homeLink?.classList.toggle("is-visible", open);
            if (homeLink) homeLink.tabIndex = open ? 0 : -1;
        }

        if (open) {
            window.requestAnimationFrame(() => {
                toolsDrawer.querySelector<HTMLAnchorElement>("a")?.focus();
            });
        } else {
            toolsToggle.focus();
        }
    };

    toolsToggle?.addEventListener("click", () => {
        setDrawerOpen(toolsToggle.ariaExpanded !== "true");
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toolsToggle?.ariaExpanded === "true") {
            event.preventDefault();
            setDrawerOpen(false);
        }
    });
</script>
