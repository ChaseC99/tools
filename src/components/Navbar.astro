---
import ToolsList from "./ToolsList.astro";
import FeedbackActions from "./FeedbackActions.astro";
const { title } = Astro.props;
---

<nav class="navbar">
    <div class="navbar-items">
        <div class="navbar-title-wrapper">
            <h1 class="navbar-page-title">{title}</h1>
            <a href="/" class="navbar-tools-link" tabindex="-1">Tools</a>
        </div>
        <div class="navbar-tools-side">
            <img
                id='tools-dropdown'
                src='/icons/tool.svg'
                alt='Tools dropdown icon'
                height=30
                role="button"
                tabindex="0"
            />
        </div>
    </div>
</nav>
<div id="tools">
    <ToolsList />
    <FeedbackActions />
</div>

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: white;
    }

    .navbar-items {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
    }

    .navbar-title-wrapper {
        position: relative;
        overflow: hidden;
    }

    .navbar-page-title {
        margin: 0;
        transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
    }

    .navbar-page-title.slide-out {
        transform: translateX(-120%);
        opacity: 0;
    }

    .navbar-tools-link {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        font-size: 2em;
        font-weight: bold;
        text-decoration: none;
        color: inherit;
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
    }

    .navbar-tools-link.drop-in {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    .navbar-tools-side {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #search {
        padding: 0.5rem;
        border-radius: 0 8px 8px 0;
        border: 1px solid #ccc;
        border-left: none;

        border-color: transparent;

        width: 0;
        visibility: hidden;
        transition: width 0.2s ease-in-out, visibility 0.2s ease-in-out, border-color 0.25s ease-in-out;
    }

    #search.show {
        width: 200px;

        /* Hide search bar until functionality is ready */
        visibility: hidden;

        border-radius: 8px;
        border-left: 1px solid #ccc;

        border-color: #ccc;

        transition: width 0.2s ease-in-out, visibility 0.2s ease-in-out, border-color 0.25s ease-in-out;
    }

    #tools-dropdown {
        cursor: pointer;
        transition: transform 0.3s ease-in-out;
    }

    #tools-dropdown.expanded {
        transform: rotate(-90deg);
    }

    #tools {
        position: fixed;
        inset: 0;
        background: white;
        z-index: 50;
        overflow-y: auto;
        padding-top: 75px;
        box-sizing: border-box;

        opacity: 0;
        visibility: hidden;
        transform: translateY(-12px);
        transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out, visibility 0s 0.3s;
    }

    #tools.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out, visibility 0s;
    }
</style>

<script>
    const dropdown = document.getElementById('tools-dropdown');

    const toggleDropdown = () => {
        const isOpen = document.getElementById('tools').classList.toggle('show');
        document.getElementById('tools-dropdown').classList.toggle('expanded');
        
        const pageTitle = document.querySelector('.navbar-page-title');
        const toolsLink = document.querySelector('.navbar-tools-link') as HTMLElement;
        const isHome = window.location.pathname === '/';

        if (isOpen) {
            if (!isHome) {
                pageTitle.classList.add('slide-out');
                toolsLink.classList.add('drop-in');
                toolsLink.tabIndex = 0;
            }
            document.body.style.overflow = 'hidden';
        } else {
            pageTitle.classList.remove('slide-out');
            toolsLink.classList.remove('drop-in');
            toolsLink.tabIndex = -1;
            document.body.style.overflow = '';
        }
    };

    dropdown.addEventListener('click', toggleDropdown);
    dropdown.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') { toggleDropdown(); }
    });
</script>
