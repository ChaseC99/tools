---
import ToolTile from "./ToolTile.astro";

const tools = [
    { name: "BMI Calculator", id: "bmi" },
    { name: "Case Converter", id: "case-converter" },
    { name: "Coin Flipper", id: "coin-flip" },
    { name: "Color Picker", id: "color-picker" },
    { name: "Blur Image", id: "blur-image" },
    { name: "Image Converter", id: "image-converter", href: "/image-converter", icon: "image-converter" },
    { name: "Remove Background", id: "remove-background" },
    { name: "HEIC to PNG", id: "heic-to-png", href: "/image-converter?to=png", icon: "image-converter" },
    { name: "PNG to ICO", id: "png-to-ico", href: "/image-converter?to=ico", icon: "image-converter" },
    { name: "SVG to PNG", id: "svg-to-png", href: "/image-converter?to=png", icon: "image-converter" },
    { name: "JSON Formatter", id: "json" },
    { name: "Party Emoji", id: "party-emoji" },
    { name: "QR Code", id: "qr-code" },
    { name: "Stopwatch", id: "stopwatch" },
    { name: "Text Counter", id: "text-counter" },
    { name: "Text Diff", id: "text-diff" },
    { name: "Timer", id: "timer" },
    { name: "Investment Calculator", id: "investment-calc" },
    { name: "Random Spinner", id: "spinner" },
    { name: "Whiteboard", id: "whiteboard" }
];
---

<div>
    {tools.map((tool) => <ToolTile name={tool.name} id={tool.id} href={tool.href} icon={tool.icon} />)}
</div>

<style>
    div {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 4px;
        justify-content: center;
    }
</style>
