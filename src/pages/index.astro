---
import PageLayout from "../layouts/PageLayout.astro";
import ToolsList from "../components/ToolsList.astro";
import FeedbackActions from "../components/FeedbackActions.astro";
---

<PageLayout title="Tools" description="A collection of free browser-based tools — no sign-up, no tracking, just useful utilities.">
	<section class="hero" aria-labelledby="home-title">
		<div class="hero-title">
			<h1 id="home-title">Tools</h1>
			<img src="/icons/tool.svg" alt="Tools" class="hero-icon" />
		</div>
		<p class="hero-subtitle">A collection of <span id="cycling-word">simple</span> tools.</p>
	</section>
	<ToolsList />
	<FeedbackActions />
</PageLayout>

<style>
	.hero {
		text-align: center;
		padding: clamp(4rem, 12vw, 7rem) var(--ui-space-4) var(--ui-space-12);
	}

	.hero-title {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--ui-space-5);
		margin-bottom: var(--ui-space-4);
	}

	.hero-icon {
		width: clamp(3.5rem, 10vw, 5.5rem);
		height: clamp(3.5rem, 10vw, 5.5rem);
		animation: wiggle 4s ease-in-out infinite;
		transform-origin: bottom center;
	}

	@keyframes wiggle {
		0%, 70%, 100% { transform: rotate(0deg); }
		75% { transform: rotate(-18deg); }
		80% { transform: rotate(16deg); }
		85% { transform: rotate(-12deg); }
		90% { transform: rotate(8deg); }
		95% { transform: rotate(-4deg); }
	}

	.hero h1 {
		font-size: var(--ui-font-size-display);
		font-weight: 800;
		margin: 0;
		line-height: 1;
	}

	.hero-subtitle {
		color: var(--ui-color-text-muted);
		font-size: var(--ui-font-size-lg);
		margin: var(--ui-space-6) 0 0;
	}

	#cycling-word {
		display: inline-block;
		color: var(--ui-color-text);
		font-weight: 650;
		transition: opacity var(--ui-motion-base) var(--ui-ease-standard), transform var(--ui-motion-base) var(--ui-ease-standard);
	}

	#cycling-word.fade-out {
		opacity: 0;
		transform: translateY(-6px);
	}

	#cycling-word.fade-in {
		opacity: 1;
		transform: translateY(0);
	}

	:global([data-theme="dark"]) .hero-icon {
		filter: invert(1);
	}

	@media (max-width: 520px) {
		.hero-title {
			gap: var(--ui-space-3);
		}
	}
</style>

<script>
	const words = ["simple", "helpful", "functional", "free", "great", "handy", "fast", "neat"];
	let index = 0;
	const el = document.getElementById("cycling-word");

	const CYCLE = 4000;
	const WIGGLE_OFFSET = Math.round(0.70 * CYCLE); // 2800ms — when the wiggle starts

	function changeWord() {
		el?.classList.add("fade-out");
		setTimeout(() => {
			index = (index + 1) % words.length;
			if (el) el.textContent = words[index];
			el?.classList.remove("fade-out");
		}, 300);
	}

	setTimeout(() => {
		changeWord();
		setInterval(changeWord, CYCLE);
	}, WIGGLE_OFFSET);
</script>
