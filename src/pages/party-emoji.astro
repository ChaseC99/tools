---
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Party Emoji Generator" description="Upload an image to create an animated party parrot-style emoji GIF with wobble and rainbow effects.">
	<div class="party-tool ui-stack">
		<p class="description ui-muted">Upload an image to generate an animated party emoji with wobble and rainbow effects. Download the result as a Slack-ready GIF.</p>
		<div class="card ui-panel ui-stack">
			<div class="ui-image-input-field">
			<div id="drop-zone" class="drop-zone ui-dropzone ui-image-input" role="button" tabindex="0" aria-label="Choose an image. PNG, JPG, or GIF. Resized to 128 by 128 pixels.">
				<span class="ui-image-input__visual" aria-hidden="true">&#x1F5BC;&#xFE0F;</span>
				<span class="ui-image-input__content"><strong class="ui-image-input__title">Choose an image</strong></span>
				<span class="ui-image-input__action" aria-hidden="true">Browse</span>
				<input class="ui-dropzone-input" type="file" id="file-input" accept="image/*" />
			</div>
			<p class="ui-image-input__support">PNG, JPG, or GIF · Resized to 128 × 128</p>
			</div>

			<div id="preview-area" class="preview-area hidden">
				<div class="canvas-wrap">
					<canvas id="preview" width="128" height="128"></canvas>
				</div>
				<span id="file-name" class="file-name"></span>
				<a id="new-image-link" class="ui-button" data-variant="ghost" data-size="sm" href="#">Change image</a>
			</div>

			<div id="controls-panel" class="controls-panel hidden">
				<div class="toggles">
					<label class="ui-choice">
						<span class="ui-switch"><input type="checkbox" id="wobble-toggle" checked /><span class="ui-switch-track"></span></span>
						Wobble
					</label>
					<label class="ui-choice">
						<span class="ui-switch"><input type="checkbox" id="color-toggle" checked /><span class="ui-switch-track"></span></span>
						Rainbow
					</label>
				</div>

				<div class="speed-row">
					<label class="ui-label" for="speed-range">Speed</label>
					<input class="ui-range" type="range" id="speed-range" min="20" max="240" value="120" />
				</div>

				<button id="download-btn" class="ui-button" disabled>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8m0 0l-3-3m3 3l3-3M2 13h12"/></svg>
					Download GIF
				</button>
			</div>
		</div>
	</div>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"></script>
	<script>
		const SIZE = 128;
		const WOBBLE_RADIUS = 4;
		const FRAME_COUNT = 10;
		const TINT_ALPHA = 0.45;

		const canvas = document.getElementById("preview") as HTMLCanvasElement;
		const ctx = canvas.getContext("2d")!;
		const dropZone = document.getElementById("drop-zone")!;
		const fileInput = document.getElementById("file-input") as HTMLInputElement;
		const speedRange = document.getElementById("speed-range") as HTMLInputElement;
		const downloadBtn = document.getElementById("download-btn") as HTMLButtonElement;
		const newImageLink = document.getElementById("new-image-link") as HTMLAnchorElement;
		const wobbleToggle = document.getElementById("wobble-toggle") as HTMLInputElement;
		const colorToggle = document.getElementById("color-toggle") as HTMLInputElement;
		const previewArea = document.getElementById("preview-area")!;
		const controlsPanel = document.getElementById("controls-panel")!;
		const fileNameEl = document.getElementById("file-name")!;

		let sourceImage: HTMLImageElement | null = null;
		let fileName = "image";
		let animFrame = 0;
		let animId: number | null = null;

		// --- Upload handling ---
		dropZone.addEventListener("click", () => fileInput.click());
		dropZone.addEventListener("keydown", (event) => {
			if (event.key === "Enter" || event.key === " ") {
				event.preventDefault();
				fileInput.click();
			}
		});

		dropZone.addEventListener("dragover", (e) => {
			e.preventDefault();
			dropZone.classList.add("drag-over");
		});

		dropZone.addEventListener("dragleave", () => {
			dropZone.classList.remove("drag-over");
		});

		dropZone.addEventListener("drop", (e) => {
			e.preventDefault();
			dropZone.classList.remove("drag-over");
			const file = e.dataTransfer?.files[0];
			if (file) loadImage(file);
		});

		fileInput.addEventListener("change", () => {
			const file = fileInput.files?.[0];
			if (file) loadImage(file);
		});

		function loadImage(file: File) {
			fileName = file.name.replace(/\.[^.]+$/, "");
			fileNameEl.textContent = file.name;
			const reader = new FileReader();
			reader.onload = () => {
				const img = new Image();
				img.onload = () => {
					sourceImage = img;
					downloadBtn.disabled = false;
					downloadBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8m0 0l-3-3m3 3l3-3M2 13h12"/></svg> Download GIF';
					dropZone.classList.add("hidden");
					previewArea.classList.remove("hidden");
					controlsPanel.classList.remove("hidden");
					startAnimation();
				};
				img.src = reader.result as string;
			};
			reader.readAsDataURL(file);
		}

		// --- New image ---
		newImageLink.addEventListener("click", (e) => {
			e.preventDefault();
			fileInput.click();
		});

		// --- Wobble toggle disables speed slider ---
		const speedRow = speedRange.closest(".speed-row")!;
		wobbleToggle.addEventListener("change", () => {
			const off = !wobbleToggle.checked;
			speedRange.disabled = off;
			speedRow.classList.toggle("disabled", off);
		});

		// --- Animation ---
		function drawFrame(target: CanvasRenderingContext2D, frame: number, totalFrames: number, wobble = wobbleToggle.checked, rainbow = colorToggle.checked) {
			const w = target.canvas.width;
			const h = target.canvas.height;
			const angle = (frame / totalFrames) * Math.PI * 2;
			const hue = (frame / totalFrames) * 360;

			const ox = wobble ? Math.cos(angle) * WOBBLE_RADIUS : 0;
			const oy = wobble ? Math.sin(angle) * WOBBLE_RADIUS : 0;

			target.clearRect(0, 0, w, h);
			target.save();

			// Draw image fitted (aspect-ratio preserved) with wobble offset
			const maxDraw = w - WOBBLE_RADIUS * 2;
			const imgW = sourceImage!.naturalWidth;
			const imgH = sourceImage!.naturalHeight;
			const scale = Math.min(maxDraw / imgW, maxDraw / imgH);
			const drawW = imgW * scale;
			const drawH = imgH * scale;
			const dx = (w - drawW) / 2 + ox;
			const dy = (h - drawH) / 2 + oy;
			target.drawImage(sourceImage!, dx, dy, drawW, drawH);

			// Rainbow tint — only affects opaque pixels
			if (rainbow) {
				target.globalCompositeOperation = "source-atop";
				target.fillStyle = `hsla(${hue}, 100%, 50%, ${TINT_ALPHA})`;
				target.fillRect(0, 0, w, h);
			}

			target.restore();
		}

		function startAnimation() {
			if (animId !== null) cancelAnimationFrame(animId);
			let lastTime = 0;

			function loop(time: number) {
				const speed = parseInt(speedRange.value);
				const interval = 1000 / (speed / 10); // fps derived from slider

				if (time - lastTime >= interval) {
					lastTime = time;
					drawFrame(ctx, animFrame, FRAME_COUNT);
					animFrame = (animFrame + 1) % FRAME_COUNT;
				}
				animId = requestAnimationFrame(loop);
			}
			animId = requestAnimationFrame(loop);
		}

		// --- GIF Export ---
		downloadBtn.addEventListener("click", () => {
			if (!sourceImage) return;
			downloadBtn.disabled = true;
			downloadBtn.textContent = "Generating\u2026";

			const speed = parseInt(speedRange.value);
			const delay = Math.round(1000 / (speed / 10)); // ms per frame

			const gif = new (window as any).GIF({
				workers: 2,
				quality: 10,
				width: SIZE,
				height: SIZE,
				workerScript: "/scripts/gif.worker.js",
				transparent: 0x00000000,
			});

			// Render each frame to an offscreen canvas
			const offscreen = document.createElement("canvas");
			offscreen.width = SIZE;
			offscreen.height = SIZE;
			const offCtx = offscreen.getContext("2d")!;

			for (let i = 0; i < FRAME_COUNT; i++) {
				drawFrame(offCtx, i, FRAME_COUNT);
				const imageData = offCtx.getImageData(0, 0, SIZE, SIZE);
				gif.addFrame(imageData, { delay, copy: true });
			}

			gif.on("finished", (blob: Blob) => {
				const url = URL.createObjectURL(blob);
				const a = document.createElement("a");
				a.href = url;
				a.download = `${fileName}-party.gif`;
				a.click();
				URL.revokeObjectURL(url);
				downloadBtn.disabled = false;
				downloadBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8m0 0l-3-3m3 3l3-3M2 13h12"/></svg> Download GIF';
			});

			gif.render();
		});
	</script>

	<style>
		.party-tool {
			align-items: center;
		}

		.description {
			max-width: 380px;
			text-align: center;
			font-size: var(--ui-font-size-sm);
			line-height: 1.5;
			margin: 0 0 1.25rem;
		}

		.card {
            max-width: 90vw;
            min-width: 30vw;
			width: min(100%, 32rem);
			align-items: center;
		}

		/* --- Drop zone --- */
		.drop-zone {
			width: 100%;
		}

		.drop-zone:hover,
		.drop-zone.drag-over {
			border-color: var(--ui-color-focus);
			background: var(--ui-color-surface-hover);
		}

		.hidden {
			display: none !important;
		}

		/* --- Preview area --- */
		.preview-area {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
		}

		.canvas-wrap {
			width: 192px;
			max-width: 90vw;
			display: flex;
			align-items: center;
			justify-content: center;
			background: repeating-conic-gradient(#eee 0% 25%, #fff 0% 50%) 50% / 16px 16px;
			overflow: hidden;
		}

		#preview {
			display: block;
			width: 100%;
			height: 100%;
			image-rendering: pixelated;
		}

		.file-name {
			font-size: 0.8rem;
			color: var(--ui-color-text-muted);
			max-width: 200px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		/* --- Controls panel --- */
		.controls-panel {
			width: 100%;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			border-top: 1px solid var(--ui-color-border);
			padding-top: 1.25rem;
		}

		/* Toggles row */
		.toggles {
			display: flex;
			justify-content: center;
			gap: 1.25rem;
		}

		/* Speed row */
		.speed-row {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.speed-row.disabled label {
			opacity: 0.4;
		}

		.speed-row input[type="range"] { flex: 1; }

		.speed-row input[type="range"]:disabled {
			opacity: 0.4;
			cursor: default;
		}

		.speed-row input[type="range"]:disabled + label {
			opacity: 0.4;
		}

		#download-btn { width: 100%; }

		#download-btn svg {
			flex-shrink: 0;
		}
	</style>
</PageLayout>
