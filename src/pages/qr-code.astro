---
import PageLayout from "@layouts/PageLayout.astro";
import QRCode from "@tools/qr-code/QRCode";
import QRMeBanner from "@components/QRMeBanner.astro";
---

<PageLayout title="QR Code Generator" description="Generate customizable QR codes with colors, shapes, and logo overlays. Download as PNG, SVG, or JPEG.">
	<div class="qr-page">
		<QRCode client:load />
		<QRMeBanner />
	</div>
</PageLayout>

<style>
	.qr-page {
		display: flex;
		flex-direction: column;
		min-height: 85vh;
		justify-content: space-between;
	}
</style>
