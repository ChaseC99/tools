---
import PageLayout from "@layouts/PageLayout.astro";
import QRCode from "@tools/qr-code/QRCode";
import QRMeBanner from "@components/QRMeBanner.astro";
---

<PageLayout title="QR Code Generator" description="Create QR codes for websites, Wi-Fi, contacts, email, SMS, phone numbers, locations, text, and calendar events. Customize and download as PNG, SVG, or JPEG.">
	<div class="qr-page">
		<QRCode client:load />
		<QRMeBanner />
	</div>
</PageLayout>

<style>
	.qr-page {
		display: flex;
		flex-direction: column;
		min-height: 85vh;
		justify-content: space-between;
	}
</style>
